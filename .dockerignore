# .venv alone is 1 GB and would be uploaded as build context on every build. The image installs
# its own dependencies from requirements.txt; nothing here is read by the Dockerfile.
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc

.git/
.gitignore
.idea/
.DS_Store
.env
.env.env.bak

# Training-time state. The image only needs artifacts/agronomic_risk.joblib, which the Dockerfile
# copies explicitly — do not exclude artifacts/.
.cache/
# Anchored to the build context root. Unanchored `data/` also matched `src/argotech/data/`, so
# `COPY src src` silently shipped a package with no `argotech.data` and the image died on first
# import at main.py:14. The exclusion is for the top-level parquet directory only.
/data/
mlruns/
mlflow.db
*.csv
