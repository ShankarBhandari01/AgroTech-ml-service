# .venv alone is 1 GB and would be uploaded as build context on every build. The image installs
# its own dependencies from requirements.txt; nothing here is read by the Dockerfile.
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc

.git/
.gitignore
.idea/
.DS_Store
.env

# Training-time artifacts. The inference service only loads the two *_model.pkl files, which the
# Dockerfile copies explicitly.
mlruns/
mlflow.db
*.csv
farmerxential_features.pkl
farmerxential_shap_explainer.pkl
